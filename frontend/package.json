{
  "name": "octopus-media-card-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "vite build && node ../scripts/sync-bundle.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:watch": "vitest",
    "verify:bundle": "node ../scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
